# ------------------------------------------------------------------
# Copy to .env.local (Next.js) and fill in your own keys.
# These are SERVER-SIDE only. Never prefix a secret with NEXT_PUBLIC_.
# ------------------------------------------------------------------

# LLM -- reply generation (/api/generate-reply)
OPENAI_API_KEY=
LLM_MAX_TOKENS=<your_key>

# TTS -- Azure Speech (primary for this mode)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia
AZURE_SPEECH_VOICE=en-US-JennyNeural

# TTS -- ElevenLabs (alternative voice path)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=4RZ84U1b4WCqpu57LvIq

# STT/TTS -- iFlytek (optional, better Mandarin accuracy)
IFLYTEK_APP_ID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=

# STT -- local Whisper service (see scripts/whisper-stt)
WHISPER_STT_URL=http://localhost:8001/transcribe
