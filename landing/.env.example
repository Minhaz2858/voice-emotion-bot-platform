# Launcher configuration.
# The Flask launcher itself needs no credentials -- it only links to the
# voice apps. Point each mode at whatever deployment you run; leave a mode
# empty to render its card without a working link.

MODE_VOICE_ONLY_URL=http://localhost:3000
MODE_ABSTRACT_URL=http://localhost:3002
MODE_CARTOONISH_URL=
MODE_HUMAN_REALISTIC_URL=

PORT=5001
FLASK_DEBUG=1
